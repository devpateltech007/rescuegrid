# RESCUEGRID 3D configuration. Copy to .env (git-ignored) or export in your shell.
# AWS credentials are NEVER stored here: use your AWS profile / env vars locally,
# and the EC2 instance role in deployment.

AWS_REGION=us-east-1
# S3 evidence bucket (created by scripts/deploy/deploy.ps1 or manually)
RESCUEGRID_BUCKET=
# Bedrock model / inference profile id (verified by scripts/verify_bedrock.py)
RESCUEGRID_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
RESCUEGRID_BRIEFING_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# 1 = live Bedrock (default). 0 = disabled (degraded mode shown in UI)
RESCUEGRID_BEDROCK=1
RESCUEGRID_S3=1
# Rehearsal only: allow a clearly-labelled OFFLINE_FIXTURE when Bedrock fails. Never shown as live.
RESCUEGRID_ALLOW_OFFLINE_FIXTURE=0
RESCUEGRID_SEED=20240927
RESCUEGRID_UNKNOWN_PENALTY=1.3
RESCUEGRID_SUSPECTED_PENALTY=25
